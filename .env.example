# ==================== 语雀配置 ====================
# YUQUE_TOKEN 是敏感信息，本地填到 .env（已被 .gitignore 忽略）
# GitHub Actions 部署时在仓库 Settings → Secrets and variables → Actions 添加同名 secret
YUQUE_TOKEN="your_yuque_token_here"
YUQUE_LOGIN="yuqueyonghu-dg6ehw"
YUQUE_REPO="slk2dt"

# ==================== Milvus 配置 ====================
MILVUS_HOST="your_milvus_host"
MILVUS_PORT="19530"
MILVUS_COLLECTION="larkwell_knowledge"

# ==================== Ollama 配置（本地模式） ====================
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_EMBED_MODEL="bge-m3"

# ==================== Cloud API 配置（公开模式） ====================
# LLM_BACKEND 后端模式：ollama | cloud | auto
#   - auto（推荐）: 优先本地 Ollama，连接失败自动降级到云端 API
#   - ollama      : 强制本地 Ollama（失败抛错，适合纯本地开发）
#   - cloud       : 强制云端 API（适合公开展示，避免暴露本地服务）
LLM_BACKEND="auto"
CLOUD_API_BASE="https://api.siliconflow.cn/v1"
CLOUD_API_KEY="your_cloud_api_key_here"
CLOUD_MODEL="Qwen/Qwen2.5-7B-Instruct"
CLOUD_EMBED_MODEL="BAAI/bge-m3"

# ==================== HuggingFace 配置 ====================
HF_ENDPOINT=https://hf-mirror.com

# ==================== Embedding 配置 ====================
EMBEDDING_DIM=1024
EMBEDDING_MODEL="BAAI/bge-m3"

# ==================== 文本切分配置 ====================
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ==================== 检索配置 ====================
TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ==================== 路径配置 ====================
BASE_DIR="./"
RAW_REPO_PATH="./repos/raw"
CLEAN_REPO_PATH="./repos/clean"
DOCS_OUTPUT_PATH="./docs/docs"

# ==================== 日志配置 ====================
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s [%(levelname)s] %(name)s - %(message)s"
